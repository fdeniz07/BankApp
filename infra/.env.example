# Copy to infra/.env and adjust values. Do not commit .env.
# SQL data lives in external Docker volume: sqlserver-2025-data

MSSQL_SA_PASSWORD=1q2w3e4r!
SQL_PORT=11433
WEBAPI_PORT=8080
CLIENT_PORT=3000
ASPNETCORE_ENVIRONMENT=Development
# Docker WebApi listens HTTP only — skip HTTPS redirect (set in compose; listed here for docs)
DISABLE_HTTPS_REDIRECTION=true

# Browser-facing API URL baked into the React build
VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=bankapp
VITE_KEYCLOAK_CLIENT_ID=bankapp-api

# Base URL embedded in email-confirmation links (client host)
PUBLIC_CLIENT_BASE_URL=http://localhost:3000

# Redis Insight UI — http://localhost:5540 (add connection host `redis`, port 6379)
REDIS_INSIGHT_PORT=5540

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Broker DEFAULT_USER/PASS + Vault secret/bankapp/messaging (WebApi overlays from Vault via AppRole).
# Note: changing credentials on an existing rabbitmq-data volume requires volume recreate.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# HashiCorp Vault (dev mode) — http://localhost:8200
# Root token is for vault-seed / UI bootstrap ONLY — WebApi uses AppRole (volume bankapp-vault-approle).
# Split KV: secret/bankapp/{jwt,database,messaging,observability}; WebApi FailClosed=true in Compose.
VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN_ID=bankapp-vault-root-token

# Keycloak lab — UI http://localhost:8180 | realm `bankapp`. WebApi dual JWT when Keycloak__Enabled=true.
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Optional social IdP (Identity Brokering) — leave empty to keep brokers off
# KEYCLOAK_GOOGLE_CLIENT_ID=
# KEYCLOAK_GOOGLE_CLIENT_SECRET=
# KEYCLOAK_GITHUB_CLIENT_ID=
# KEYCLOAK_GITHUB_CLIENT_SECRET=

# OpenTelemetry lab — Grafana http://localhost:3001 (avoid clash with client :3000)
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ELK lab — ES http://localhost:9200 | Kibana http://localhost:5601 | Logstash HTTP :8081 / TCP :50000
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
LOGSTASH_HTTP_PORT=8081
LOGSTASH_TCP_PORT=50000
ELASTIC_JAVA_OPTS=-Xms512m -Xmx512m
LOGSTASH_JAVA_OPTS=-Xms256m -Xmx256m

TOKEN_AUDIENCE=BankAppAudience
TOKEN_ISSUER=BankAppIssuer
TOKEN_EXPIRATION_MINUTES=60
TOKEN_REMEMBER_ME_MINUTES=10080 # 7 days
TOKEN_SECURITY_KEY=BankApp-Super-Secret-Security-Key-For-Jwt-Must-Be-At-Least-64-Bytes-Long-1234567890
